    "index": "node scripts/build-index.ts",
    "check:data": "node scripts/check-data-policy.ts",
    "cache:pull": "node --env-file-if-exists=.env scripts/sync-cache.ts --pull",
    "cache:synchronize": "node --env-file-if-exists=.env scripts/sync-cache.ts",
    "typecheck": "astro check && tsc --noEmit -p worker",
    "test": "node --test scripts/tests/"
