    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261106.1",
    "@types/node": "^26.6.6",
    "aws4fetch": "^1.0.20",
    "stream-json": "^3.8.0",
    "typescript": "^6.0.3"
  }
}
