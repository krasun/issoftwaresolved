{
  "name": "issoftwaresolved",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "fetch": "node --env-file-if-exists=.env scripts/fetch.ts",
    "hn:sample": "node scripts/hacker-news-sample.ts",
