{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "issoftwaresolved",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-30",
	"assets": {
		"directory": "./dist",
		// Only the Pirsch proxy runs the Worker, everything else is served as static files.
		"run_worker_first": ["/static/files/pa.js", "/p/pv", "/p/e", "/p/s"]
	}
}
