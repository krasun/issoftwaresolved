# Used by the OpenRouter source and `npm run models:ask`.
OPENROUTER_API_KEY=

# Used by the Product Hunt source. Create an app at https://www.producthunt.com/v2/oauth/applications and copy its developer token.
PRODUCT_HUNT_TOKEN=

# The private bucket behind `npm run cache:synchronize` and `npm run cache:pull`. Not needed to build the site.
# Create an "Object Read & Write" token limited to this bucket under R2 > Manage API Tokens.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=issoftwaresolved
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
