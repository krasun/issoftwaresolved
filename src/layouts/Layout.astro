---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { site } from '../content/site';
import { getSignals, getSources } from '../lib/content';

type Props = {
	title?: string;
};

const { title } = Astro.props;
const siteName = 'Is software solved?';

const signals = await getSignals();
const sources = await getSources();

const links = [
	site.score !== undefined && { href: '/score', label: 'Score' },
	signals.length > 0 && { href: '/signals', label: 'Signals' },
	sources.length > 0 && { href: '/sources', label: 'Data sources' },
	{ href: '/how-it-works', label: 'How it works' },
	{ href: '/about', label: 'About' },
].filter((link) => !!link);

const path = Astro.url.pathname.replace(/\/$/, '');
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#fffef9" />
		<meta name="color-scheme" content="light" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="A public index tracking whether software is solved, using jobs, AI use, revenue, security, bugs and outages."
		/>
		<Font cssVariable="--font-geist" preload />
		<Font cssVariable="--font-geist-mono" preload />
		<title>{title ? `${title} | ${siteName}` : siteName}</title>
		<script is:inline>
			// Hides the final numbers until they start counting, so they never flash first.
			if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
				document.documentElement.classList.add('counting');
				setTimeout(() => document.documentElement.classList.remove('counting'), 1000);
			}
		</script>
		{
			import.meta.env.PROD && (
				<script
					is:inline
					defer
					src="/static/files/pa.js"
					id="pianjs"
					data-hit-endpoint="/p/pv"
					data-event-endpoint="/p/e"
					data-session-endpoint="/p/s"
				/>
			)
		}
	</head>
	<body>
		<header class="nav">
			<div class="nav-inner">
				<a class="brand" href="/">{siteName}</a>
				<nav class="nav-links" aria-label="Main">
					{
						links.filter(({ href }) => href !== '/sources').map((link) => (
							<a href={link.href} aria-current={path === link.href ? 'page' : undefined}>
								{link.label}
							</a>
						))
					}
				</nav>
				{
					site.score !== undefined && path !== '/score' && (
						<div class="nav-actions">
							<a class="btn btn-solid btn-sm" href="/score">{Math.round(site.score)}% solved</a>
						</div>
					)
				}
			</div>
		</header>

		<main>
			<slot />
		</main>

		<footer class="footer">
			<div class="footer-inner">
				<span>Made by <a class="footer-author" href="/about">Dmytro Krasun</a></span>
				<nav class="footer-links" aria-label="Footer">
					{links.map((link) => <a class:list={{ 'in-top-nav': link.href !== '/sources' }} href={link.href}>{link.label}</a>)}
				</nav>
			</div>
		</footer>
		<script>
			import { CountUp } from 'countup.js';

			// Speeds up, then settles onto the final value instead of stopping abruptly.
			const smooth = (t: number, b: number, c: number, d: number) =>
				(c / 2) * (1 - Math.cos((Math.PI * Math.min(t, d)) / d)) + b;

			if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
				for (const el of document.querySelectorAll<HTMLElement>('[data-count]')) {
					const [, prefix, number, suffix] = el.textContent.match(/^(\D*)([\d.,]+)(\D*)$/) ?? [];
					if (!number) continue;
					new CountUp(el, Number(number.replaceAll(',', '')), {
						duration: 0.8,
						prefix,
						suffix,
						decimalPlaces: number.split('.')[1]?.length ?? 0,
						easingFn: smooth,
					}).start();
				}
			}
			document.documentElement.classList.replace('counting', 'counted');
		</script>
	</body>
</html>
