---
import 'katex/dist/katex.min.css';
import Layout from '../layouts/Layout.astro';
import { site } from '../content/site';
import { scoreHistory as history } from '../lib/content';
import { math } from '../lib/math';

const scoreLine = history
	?.map((h, i) => `${(i / (history.length - 1)) * 100},${100 - h.score}`)
	.join(' ');
const latest = history?.at(-1);
const formula = math(String.raw`\begin{aligned} \text{Score} &= \frac{1}{n}\sum_{i=1}^{n} \text{Question}_i \\[6pt] \text{Question}_i &= \frac{1}{m}\sum_{j=1}^{m} \text{Signal}_j \end{aligned}`);
---

<Layout title="Solved score">
	<section class="section">
		<div class="score-head">
			<div>
				<h1 class="page-title"><span data-count>{site.score}%</span>. {site.verdict}</h1>
				<p>How far software has moved toward solved since ChatGPT launched in November 2022, based on 4 questions and the signals behind them.</p>
				<p>The line is recalculated from today's data rather than recorded at the time, and it can jump when a new signal joins.</p>
			</div>
			<a class="score-formula" href="/how-it-works#formula">
				<span class="score-formula-title">
					How it works
					<svg class="stat-arrow" viewBox="0 0 16 16" aria-hidden="true">
						<path d="M2 8h11M9 4l4 4-4 4" />
					</svg>
				</span>
				<span class="score-formula-math" set:html={formula} />
			</a>
		</div>
		{
			history && latest && (
				<div class="chart">
					<div class="chart-y" aria-hidden="true">
						{[100, 75, 50, 25, 0].map((tick) => (
							<span>{tick}</span>
						))}
					</div>
					<div class="chart-plot">
						<svg
							viewBox="0 0 100 100"
							preserveAspectRatio="none"
							role="img"
							aria-label={`Solved score from ${history[0].date} to ${latest.date}`}
						>
							<polyline points={scoreLine} />
						</svg>
						<span class="chart-end" style={`top: ${100 - latest.score}%`} data-count>
							{latest.score}%
						</span>
					</div>
					<div class="chart-x" aria-hidden="true">
						<span>{history[0].date}</span>
						<span>{latest.date}</span>
					</div>
				</div>
			)
		}
	</section>

	<section class="section">
		<div class="question-cards">
			{
				site.areas?.map((area) => (
					<article class="question-card">
						<div class="question-top">
							<h2 class="card-title">{area.name}</h2>
							<strong>{area.score}%</strong>
						</div>
						<div class="progress" aria-hidden="true"><i style={`width: ${area.score}%`} /></div>
						{area.note && <p class="question-note">{area.note}</p>}
							<ul class="question-signals">
							{area.signals.map(({ href, name, score, reason }) => (
								<li>
									<a href={href}>
										<div>
											<strong>{name}</strong>
											<span>
												{score}%
												<svg class="stat-arrow" viewBox="0 0 16 16" aria-hidden="true">
													<path d="M2 8h11M9 4l4 4-4 4" />
												</svg>
											</span>
										</div>
										<div class="progress progress-small" aria-hidden="true"><i style={`width: ${score}%`} /></div>
										<p>{reason}</p>
									</a>
								</li>
							))}
						</ul>
					</article>
				))
			}
		</div>
	</section>
</Layout>
