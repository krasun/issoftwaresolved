---
import TrendChart from '../../components/TrendChart.astro';
import { signalArea, areaAnchor } from '../../lib/content';
import Layout from '../../layouts/Layout.astro';
import { getSignalChecks, getSignals, getSources } from '../../lib/content';

export const getStaticPaths = async () =>
	(await getSignals()).map((signal) => ({ params: { id: signal.id }, props: { signal } }));

const { signal } = Astro.props;
const area = signalArea(signal.id);
const scored = area?.signals.find(row => row.id === signal.id);

const { name, question, metric, solvedIf, value, change, trend, trendLabel, trendScale, prompt, trendName, caution, quote, score, scoreReason, comparison, events, chartNote, analysis, status, rule, direction, fromHigh } = signal.data;
const statCount = 1 + [change, status, fromHigh].filter(Boolean).length;
const sources = (await getSources()).filter((source) => source.data.signal.id === signal.id || source.id === scored?.source);
const scoredSource = ({ id, data }: (typeof sources)[number]) => id === scored?.source || data.role === 'headline';

const checks = getSignalChecks(signal.id);

const chartTrend = trend && trend.length >= 2 ? trend : undefined;

---

<Layout title={name}>
	<section class="section">
		<div class="section-head">
			<nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/score">Score</a> / {area ? <a href={`/score#${areaAnchor(area.name)}`}>{area.name}</a> : <a href="/signals">Signals</a>} / <span aria-current="page">{name}</span></nav>
			<h1 class="page-title">{name}</h1>
			<p>{question}</p>
			{area ? <p>Contributes to: <a class="inline-link" href={`/score#${areaAnchor(area.name)}`}>{area.name}</a>. Signal score: {score} / 100. Relative weight within this question: {scored?.weight}.</p> : <p>Supporting context; does not contribute to the overall score.</p>}
			<p class="source-links">
				<a href="/signals">All signals</a>
				<a href={`/api/signals/${signal.id}.json`}>JSON</a>
			</p>
		</div>
	</section>

	<section class="stats" aria-label="Signal summary" style={`--stat-count: ${statCount}`}>
		{
			status && (
				<div class="stat">
					<span class="eyebrow">Status</span>
					<strong class={`status-text ${direction}`}>{status}</strong>
				</div>
			)
		}
		<div class="stat">
			<span class="eyebrow">Latest value</span>
			<strong><span data-count>{value}</span></strong>
		</div>
		{
			change && (
				<div class="stat">
					<span class="eyebrow">Year over year</span>
					<strong>{change}</strong>
				</div>
			)
		}
		{
			fromHigh && (
				<div class="stat">
					<span class="eyebrow">Distance from high</span>
					<strong>{fromHigh.replace(' from high', '')}</strong>
				</div>
			)
		}
	</section>

	{
		caution && (
			<section class="section">
				<div class="caution">
					<strong>Caution</strong>
					{caution.map((line) => (
						<p>{line}</p>
					))}
				</div>
			</section>
		)
	}

	{chartTrend && <section class="section"><div class="section-head"><h2>Observed trend</h2>{trendLabel && <p>{trendLabel}</p>}{chartNote && <p>{chartNote}</p>}</div><TrendChart name={trendName ?? trendLabel ?? metric} trend={chartTrend} scale={trendScale} comparison={comparison} events={events} /></section>}

	<section class="section">
		<div class="section-head">
			<h2>What it measures</h2>
		</div>
		<dl class="signal-details">
			<div>
				<dt>Metric</dt>
				<dd>{metric}</dd>
			</div>
			<div>
				<dt>Solved if</dt>
				<dd>{solvedIf}</dd>
			</div>
			{
				score !== undefined && (
					<div>
						<dt>Signal score</dt>
						<dd>{score} / 100. {scoreReason} <a class="inline-link" href="/score">How it is scored</a></dd>
					</div>
				)
			}
			{
				rule && (
					<div>
						<dt>Status rule</dt>
						<dd>{rule}</dd>
					</div>
				)
			}
		</dl>
	</section>

	{
		prompt && (
			<section class="section">
				<div class="section-head">
					<h2>The prompt</h2>
					<p>Every model got exactly this, three times, with no other instructions.</p>
				</div>
				<pre class="prompt-text">{prompt}</pre>
			</section>
		)
	}

	{
		analysis && (
			<section class="section">
				<div class="section-head">
					<h2>{analysis.title}</h2>
					<p>{analysis.intro}</p>
				</div>
				<ul class="findings">
					{analysis.points.map((point) => (
						<li>{point}</li>
					))}
				</ul>
				{quote && (
					<figure class="quote">
						<a href={quote.url}>
							<img src={quote.image} alt={`Post by ${quote.author}: ${quote.text}`} width="1162" height="848" loading="lazy" />
						</a>
						<figcaption>
							<a class="inline-link" href={quote.url}>{quote.author}</a>, {quote.role}. One team's experience, not a measurement.
						</figcaption>
					</figure>
				)}
			</section>
		)
	}

	{
		checks.length > 0 && (
			<section class="section">
				<div class="section-head">
					<h2>Update history</h2>
					<p>The reading on each date we checked, separate from the historical observations above.</p>
				</div>
				<div class="table-wrap">
					<table>
						<thead>
							<tr>
								<th scope="col">Date</th>
								<th scope="col">Value</th>
								<th scope="col">Year over year</th>
								<th scope="col">Status</th>
							</tr>
						</thead>
						<tbody>
							{checks.map((check) => (
								<tr>
									<td>{check.date}</td>
									<td>{check.value}</td>
									<td>{check.change ?? '—'}</td>
									<td>{check.status ?? '—'}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</section>
		)
	}

	{
		sources.length > 0 && (
			<section class="section">
				<div class="section-head">
					<h2>{sources.length > 1 ? 'Sources' : 'Source'}</h2>
				</div>
				<div class="table-wrap">
					<table>
						<thead>
							<tr>
								<th scope="col">Source</th>
								<th scope="col">Role</th>
								<th scope="col">Measures</th>
								<th scope="col">Latest data</th>
							</tr>
						</thead>
						<tbody>
							{sources.map(({ id, data }) => (
								<tr>
									<td>
										<a href={`/sources/${id}`}>{data.name}</a>
									</td>
									<td>{scoredSource({ id, data }) ? 'Scored measurement' : 'Supporting context'}</td>
									<td>{data.measures}</td>
									<td>{data.checked}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</section>
		)
	}
</Layout>
