---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { getSignals, getSources } from '../lib/content';

const published = new Set((await getSignals()).map(({ id }) => id));
const sources = await getSources();

// Signals in their usual order, leaving out any without sources.
const groups = (await getCollection('signals'))
	.sort((a, b) => a.data.order - b.data.order)
	.map((signal) => ({
		signal,
		sources: sources.filter((source) => source.data.signal.id === signal.id),
	}))
	.filter((group) => group.sources.length > 0);
---

<Layout title="Data sources">
	<section class="section">
		<div class="section-head">
			<h1 class="page-title">Data sources</h1>
			<p>Where every number comes from, grouped by signal.</p>
		</div>
	</section>

	{
		groups.map(({ signal, sources }) => (
			<section class="section">
				<div class="section-head">
					<h2>
						{published.has(signal.id) ? (
							<a class="heading-link" href={`/signals/${signal.id}`}>
								{signal.data.name}
							</a>
						) : (
							signal.data.name
						)}
					</h2>
					<p>{signal.data.question}</p>
				</div>
				<div class="table-wrap">
					<table>
						<thead>
							<tr>
								<th scope="col">Source</th>
								<th scope="col">Measures</th>
								<th scope="col">Role</th>
								<th scope="col">Latest data</th>
							</tr>
						</thead>
						<tbody>
							{sources.map(({ id, data }) => (
								<tr>
									<td>
										<a href={`/sources/${id}`}>{data.name}</a>
									</td>
									<td>{data.measures}</td>
									<td>{data.role === 'headline' ? 'Headline number' : 'Background only'}</td>
									<td>{data.checked}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</section>
		))
	}
</Layout>
