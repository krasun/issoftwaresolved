---
import Layout from '../layouts/Layout.astro';
import { site } from '../content/site';
import { getLastUpdated, getSignals, getSources } from '../lib/content';

const signals = await getSignals();
const sources = await getSources();
const lastUpdated = await getLastUpdated();
const verdict = site.score === undefined ? 'Undefined.' : site.verdict;

// The score since 2023. The minimum range keeps small moves looking small.
const recentScores = site.history?.map(({ score }) => score);
const scoreLine = (() => {
	if (!recentScores || recentScores.length < 2) return undefined;
	const low = Math.min(...recentScores);
	const high = Math.max(...recentScores);
	const range = Math.max(high - low, 20);
	const bottom = low - (range - (high - low)) / 2;
	return recentScores
		.map((score, i) => `${(i / (recentScores.length - 1)) * 100},${100 - ((score - bottom) / range) * 100}`)
		.join(' ');
})();

const stats = [
	site.score !== undefined && {
		label: 'Solved index',
		value: site.score,
		suffix: '%',
		spark: scoreLine,
		href: '/score',
	},
	signals.length > 0 && { label: 'Signals tracked', value: signals.length, href: '/signals' },
	sources.length > 0 && { label: 'Data sources', value: sources.length, href: '/sources' },
	lastUpdated && { label: 'Last updated', value: lastUpdated, href: undefined },
].filter((stat) => !!stat);
---

<Layout>
	<section class="hero">
		<div class="hero-copy">
			<h1>Is software solved?</h1>
			<p>An index of how close AI is to building and maintaining quality software with little human help.</p>
		</div>

		{
			verdict && (
				<div class="horizon">
					<div class="horizon-grid" aria-hidden="true" />
					<a class="dial" href="/score">
						<strong class="dial-value">{verdict}</strong>
					</a>
				</div>
			)
		}
	</section>

	{
		stats.length > 0 && (
			<section class="stats" aria-label="Index summary" style={`--stat-count: ${stats.length}`}>
				{stats.map((stat) => {
					const Tag = stat.href ? 'a' : 'div';
					return (
						<Tag class="stat" href={stat.href}>
							<span class="eyebrow">{stat.label}</span>
							<strong>
								<span data-count={typeof stat.value === 'number' ? true : undefined}>
									{stat.value}
								</span>
								{stat.suffix && <small>{stat.suffix}</small>}
							</strong>
							{stat.spark && (
								<svg class="stat-spark" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
									<polyline points={stat.spark} />
								</svg>
							)}
							{stat.href && (
								<svg class="stat-arrow" viewBox="0 0 16 16" aria-hidden="true">
									<path d="M2 8h11M9 4l4 4-4 4" />
								</svg>
							)}
						</Tag>
					);
				})}
			</section>
		)
	}
</Layout>
