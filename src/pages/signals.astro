---
import { site } from '../content/site';
import { areaAnchor } from '../lib/content';
import Layout from '../layouts/Layout.astro';
import { getSignals } from '../lib/content';

const signals = await getSignals();
const groups = [...(site.areas ?? []).map(area => ({ name: area.name, href: `/score#${areaAnchor(area.name)}`, signals: signals.filter(signal => area.signals.some(row => row.href === `/signals/${signal.id}`)) })), { name: "Supporting context", href: undefined, signals: signals.filter(signal => !site.areas?.some(area => area.signals.some(row => row.href === `/signals/${signal.id}`))) }].filter(group => group.signals.length);
const suggestUrl = 'https://github.com/krasun/issoftwaresolved/issues/new?title=Signal%20suggestion%3A%20';
// The card only fills a gap in the last row of three, and never starts a row of its own.
const showSuggestCard = signals.length % 3 !== 0;

// Each card has its own scale. The minimum range keeps small moves looking small.
const MIN_RANGE = 20;
const sparkPoints = (values: number[]) => {
	const low = Math.min(...values);
	const high = Math.max(...values);
	const range = Math.max(high - low, MIN_RANGE);
	const pad = range * 0.1;
	const bottom = low - (range - (high - low)) / 2;
	return values
		.map((v, i) => `${(i / (values.length - 1)) * 100},${100 - ((v - bottom + pad) / (range + pad * 2)) * 100}`)
		.join(' ');
};
---

<Layout title="Signals">
	<section class="section">
		<div class="section-head">
			<div class="head-row">
				<div>
					<h1 class="page-title">Signals</h1>
					<p>If software were solved, each of these numbers would show it.</p>
					<p>Based on <a class="inline-link" href="/sources">these data sources</a>. <a class="inline-link" href={suggestUrl}>Suggest a signal</a>.</p>
				</div>

			</div>
		</div>
	</section>

	{
		signals.length > 0 && (
			<section class="section">
				{groups.map(group => <><div class="section-head"><h2>{group.href ? <a href={group.href}>{group.name}</a> : group.name}</h2>{!group.href && <p>These signals do not contribute to the overall score.</p>}</div><div class="cards">
					{group.signals.map(({ id, data }) => (<article class="card">
								<div class="card-top">
									<h2 class="card-title">
										<a class="card-link" href={`/signals/${id}`}>
											{data.name}
										</a>
									</h2>
									<svg class="stat-arrow" viewBox="0 0 16 16" aria-hidden="true">
										<path d="M2 8h11M9 4l4 4-4 4" />
									</svg>
								</div>
								<p class="question">{data.question}</p>
								<div class="reading">
									<strong data-count>{data.value}</strong>
									<div class="reading-side">
										{data.status && <span class={`status-text ${data.direction}`}>{data.status}</span>}
										{data.change ? <span>{data.change} YoY</span> : <span aria-hidden="true">&nbsp;</span>}
									</div>
								</div>
								{data.recent && data.recent.length >= 2 ? (
								<div class="signal-spark" aria-hidden="true">
									<svg class="spark" viewBox="0 0 100 100" preserveAspectRatio="none">
										<polyline points={sparkPoints(data.recent)} />
									</svg>
								</div>
							) : (
								<div class="spark spark-pending">Trend starts with the next check</div>
							)}
							<p class="card-metric">{data.metric}</p>
							</article>))}
					{false && showSuggestCard && (
						<article class:list={['card card-suggest', { 'card-suggest-odd': signals.length % 2 === 1 }]}>
							<div class="card-top">
								<h2 class="card-title">
									<a class="card-link" href={suggestUrl}>
										Suggest a signal
									</a>
								</h2>
								<svg class="stat-arrow" viewBox="0 0 16 16" aria-hidden="true">
									<path d="M2 8h11M9 4l4 4-4 4" />
								</svg>
							</div>
							<p class="question">What number would change your mind?</p>
							<div class="signal-spark" aria-hidden="true">
								<div class="spark spark-empty"></div>
							</div>
							<p class="card-metric">Open an issue on GitHub with the number and where its data comes from</p>
						</article>
					)}
				</div></>)}
			</section>
		)
	}
</Layout>
